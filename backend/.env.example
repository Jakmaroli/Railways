# RailSync Production Configuration
# Copy this file to .env or populate in your Railway deployment dashboard

ENV=production
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres.railway.internal:5432/railsync
REDIS_URL=redis://default:password@redis.railway.internal:6379/0
JWT_SECRET=generate_strong_random_secret_with_at_least_32_characters
JWT_ISSUER=railsync-api
JWT_AUDIENCE=railsync-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
RAILSYNC_ALLOWED_ORIGINS=https://railsync-web.up.railway.app
COOKIE_SECURE=true
TRUSTED_PROXIES=127.0.0.1,::1
